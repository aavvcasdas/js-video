{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixelle Arena Video Project",
  "description": "Local render manifest written by an Arena agent. Images and audio are generated/provided assets, not fetched by this renderer.",
  "type": "object",
  "required": ["schema_version", "project", "video", "scenes"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "default": "zh-CN" },
        "author": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 256, "maximum": 4096, "default": 1080 },
        "height": { "type": "integer", "minimum": 256, "maximum": 4096, "default": 1920 },
        "fps": { "type": "integer", "minimum": 12, "maximum": 60, "default": 30 },
        "template": {
          "type": "string",
          "pattern": "^(1080x1920|1920x1080|1080x1080)/image_[A-Za-z0-9_-]+\\.html$",
          "default": "1080x1920/image_default.html"
        },
        "output": { "type": "string", "default": "output/final.mp4" },
        "template_params": { "type": "object", "default": {} },
        "bgm": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "description": "Relative audio path inside the project folder." },
                "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.12 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["id", "narration", "image"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "title": { "type": "string", "default": "Uses project.title" },
          "narration": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "description": "On-screen text; defaults to narration." },
          "image_prompt": { "type": "string", "description": "Agent prompt used to generate the local image via Arena's native image-generation tool." },
          "image": { "type": "string", "description": "Relative PNG, JPEG, or WebP generated/provided by the agent." },
          "audio": { "type": ["string", "null"], "description": "Optional relative voiceover file. Use Arena speech generation or a user-provided file." },
          "duration": { "type": "number", "minimum": 0.25, "maximum": 120, "description": "Scene seconds; required when audio is absent. If both are set, audio is trimmed/padded to this duration." }
        },
        "anyOf": [
          { "required": ["duration"] },
          {
            "required": ["audio"],
            "properties": { "audio": { "type": "string", "minLength": 1 } }
          }
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "accessed_on": { "type": "string" }
        },
        "additionalProperties": false
      },
      "default": []
    }
  },
  "additionalProperties": false
}
